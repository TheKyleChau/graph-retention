{
  "name": "@graph-retention/mcp-server",
  "version": "0.1.0",
  "description": "MCP stdio server for graph retention",
  "type": "module",
  "bin": {
    "graph-retention-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
