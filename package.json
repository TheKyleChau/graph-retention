{
  "name": "graph-retention",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first graph memory with retention policies for AI agents",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "clean": "pnpm -r --if-present run clean",
    "install-mcp": "node scripts/install-mcp.mjs"
  },
  "engines": {
    "node": ">=22"
  },
